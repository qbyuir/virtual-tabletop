<h1>Suas Salas</h1>

<%# Mostra todas as salas criadas pelo usuário %>
<% @room.each do |room| %>
    <%# Mostra o nome da sala e um botão para entrar na respectiva sala %>
  <p> <%= room.name %> <%= link_to "Entrar na Sala", room_path(room)%> </p>
<% end %>

<%# Botão que leva à página de criação de sala %>
<%= link_to "Criar Sala", new_room_path %>

